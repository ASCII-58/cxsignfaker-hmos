  /** ç‚¹å‡»æ”¶è—é’ˆ = é€‰ä¸­è¯¥æ”¶è—ï¼ˆé€‰ç‚¹é’ˆç§»è¿‡å»å¹¶å¡«å……å¤‡æ³¨ï¼Œä¿å­˜å³ä¿®æ”¹ï¼‰ */
  onFavoriteClick(id: number) {
    const loc = this.locations.find((l: SavedLocation) => l.id === id)
    if (loc) {
      this.selectFavorite(loc)
    }
  }

  /** å–æ¶ˆé€‰ç‚¹ï¼šåŒæ­¥ç§»é™¤åœ°å›¾ä¸Šçš„é€‰ç‚¹é’ˆ */
  clearSelection() {
    this.editingId = -1
    this.noteInput = ''
    this.hasPicked = false
    this.pickedAddress = ''
    this.syncPin()
  }

  // ---------- H5 â†’ ArkTS å›è°ƒï¼ˆregisterJavaScriptProxy æ³¨å†Œï¼‰ ----------

  async saveLocation() {
    if (!this.hasPicked) {
      promptAction.showToast({ message: 'è¯·å…ˆåœ¨åœ°å›¾ä¸Šç‚¹é€‰ä½ç½®' })
      return
    }
    const note = this.noteInput.trim()
    // é€‰ç‚¹é’ˆæ‹–åŠ¨ç»“æŸæ—¶åæ ‡å·²åŒæ­¥åˆ° gcjLat/gcjLon
    const bd = ChaoxingUtils.gcj02_to_bd09(this.gcjLat, this.gcjLon)
    const latitude = ChaoxingUtils.toLocationInt(bd.lat).toString()
    const longitude = ChaoxingUtils.toLocationInt(bd.lon).toString()
    const address = this.pickedAddress
    try {
      let result: number
      if (this.editingId === -1) {
        result = await this.dbManager.insertSavedLocation({
          note,
          latitude,
          longitude,
          address
        })
      } else {
        result = await this.dbManager.updateSavedLocation(this.editingId, {
          note,
          latitude,
          longitude,
          address
        })
      }
      if (result !== 1) {
        promptAction.showToast({ message: 'ä¿å­˜å¤±è´¥' })
        return
      }
      promptAction.showToast({ message: 'å·²ä¿å­˜' })
      this.clearSelection()
      await this.loadLocations()
    } catch (e) {
      hilog.error(DOMAIN, TAG, `Failed to save location: ${e.message}`);
      promptAction.showToast({ message: 'ä¿å­˜å¤±è´¥' })
    }
  }

  confirmDelete(loc: SavedLocation) {
    AlertDialog.show({
      title: 'åˆ é™¤æ”¶è—ä½ç½®',
      message: `ç¡®å®šåˆ é™¤ã€Œ${this.locationTitle(loc)}ã€å—ï¼Ÿ`,
      primaryButton: {
        value: 'å–æ¶ˆ',
        action: () => {
        }
      },
      secondaryButton: {
        value: 'åˆ é™¤',
        action: () => {
          this.deleteLocation(loc.id)
        }
      }
    })
  }

  async deleteLocation(id: number) {
    try {
      const result = await this.dbManager.deleteSavedLocation(id)
      promptAction.showToast({ message: result === 1 ? 'å·²åˆ é™¤' : 'åˆ é™¤å¤±è´¥' })
      if (result === 1) {
        if (this.editingId === id) {
          this.clearSelection()
        }
        await this.loadLocations()
      }
    } catch (e) {
      hilog.error(DOMAIN, TAG, `Failed to delete location: ${e.message}`);
      promptAction.showToast({ message: 'åˆ é™¤å¤±è´¥' })
    }
  }

