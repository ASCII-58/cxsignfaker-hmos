                    note,
                    latitude,
                    longitude,
                    address
                });
            }
            else {
                result = await this.dbManager.updateSavedLocation(this.editingId, {
                    note,
                    latitude,
                    longitude,
                    address
                });
            }
            if (result !== 1) {
                promptAction.showToast({ message: 'ä¿å­˜å¤±è´¥' });
                return;
