    // ---------- é€‰ç‚¹ ----------
    /** å®‰å…¨æ‰§è¡Œ H5 è„šæœ¬ï¼›é¡µé¢æœªå°±ç»ªæˆ–æ‰§è¡Œå¤±è´¥æ—¶é™é»˜ï¼ˆçŠ¶æ€ä¼šåœ¨ onMapReady æ¡æ‰‹æ—¶è¡¥æ¨ï¼‰ */
    runJs(expr) {
        if (!this.webReady) {
            return;
        }
        try {
            this.webController.runJavaScript(expr);
        }
        catch (e) {
            hilog.error(DOMAIN, TAG, `Run JS failed: ${e.message}`);
        }
    }
    /** æ”¶è—é’ˆå…¨é‡é‡ç”»ï¼ˆç¥ç€è‰²æ˜Ÿå½¢é’ˆ + å¤‡æ³¨æ ‡ç­¾ï¼‰ */
    syncFavorites() {
        const pins = this.locations.map((loc) => {
            const gcj = ChaoxingUtils.bd09_to_gcj02(ChaoxingUtils.parseStoredCoord(loc.latitude), ChaoxingUtils.parseStoredCoord(loc.longitude));
            return {
                id: loc.id,
                lat: gcj.lat,
                lng: gcj.lon,
                label: this.markerLabel(loc)
            };
        });
        this.runJs(`window.setFavorites(${JSON.stringify(JSON.stringify(pins))})`);
    }
    /** æ”¶è—é’ˆä¸Šæ–¹çš„æ ‡ç­¾æ–‡æ¡ˆï¼šæœ‰å¤‡æ³¨æ—¶"å¤‡æ³¨ Â· åœ°ç‚¹"ï¼Œå¦åˆ™åªæ˜¾ç¤ºåœ°ç‚¹ */
    markerLabel(loc) {
        return loc.note !== '' ? `${loc.note} Â· ${loc.address}` : loc.address;
    }
    /** é€‰ç‚¹é’ˆï¼ˆçº¢è‰²æ°´æ»´é’ˆ + åœ°å€æ ‡ç­¾ï¼‰ï¼›ä½ç½®æˆ–æ ‡ç­¾å˜åŒ–æ—¶åŒæ­¥ */
    syncPin() {
        if (this.hasPicked) {
            const label = this.pickedAddress !== '' ? this.pickedAddress : 'é€‰ç‚¹';
            this.runJs(`window.setPin(${this.gcjLat},${this.gcjLon},${JSON.stringify(label)},true)`);
        }
        else {
            this.runJs('window.clearPin()');
        }
    }
    // ---------- é€†åœ°ç†ç¼–ç  ----------
    /** é•œå¤´é£è¡Œåˆ°æŒ‡å®šç‚¹ */
    flyTo(lat, lon, zoom) {
        this.runJs(`window.flyTo(${lat},${lon},${zoom})`);
    }
    /**
     * æ‹¦æˆªç“¦ç‰‡è¯·æ±‚ï¼šå‘½ä¸­ç¼“å­˜ç›´æ¥å›æœ¬åœ°æ–‡ä»¶ï¼›æœªå‘½ä¸­æ”¾è¡Œç½‘ç»œå¹¶å¼‚æ­¥è½ç›˜ã€‚
     * å¯¹åº” Map Kit ç“¦ç‰‡ç¼“å­˜ç®¡ç†ä¸­ diskCacheEnabled/diskCachePath çš„è‡ªç®¡å®ç°ã€‚
     */
    onInterceptTile(event) {
        if (!event) {
            return undefined;
        }
        const url = event.request.getRequestUrl();
        if (!url.includes('appmaptile')) {
            return undefined;
        }
        const m = url.match(/[?&]x=(\d+)&y=(\d+)&z=(\d+)/);
        if (!m || this.tileCacheDir === '') {
            return undefined;
        }
        const key = `${m[3]}_${m[1]}_${m[2]}.png`;
        const filePath = `${this.tileCacheDir}/${key}`;
        try {
            if (fs.accessSync(filePath)) {
                const file = fs.openSync(filePath, fs.OpenMode.READ_ONLY);
                const resp = new WebResourceResponse();
                resp.setResponseData(file.fd);
                resp.setResponseEncoding('utf-8');
                resp.setResponseMimeType('image/png');
                return resp;
            }
        }
        catch (e) {
            // ç¼“å­˜è¯»å–å¤±è´¥åˆ™èµ°ç½‘ç»œ
        }
        this.cacheTileAsync(url, filePath, key);
        return undefined;
    }
    // ---------- å¢åˆ æ”¹ ----------
    /** æœªå‘½ä¸­çš„ç“¦ç‰‡å¼‚æ­¥æ‹‰å–è½ç›˜ï¼›å®Œæˆååš LRU å®¹é‡æ£€æŸ¥ï¼ˆä¸Šé™ 4MBï¼‰ */
    cacheTileAsync(url, filePath, key) {
        if (this.tileInflight.has(key)) {
            return;
        }
        this.tileInflight.add(key);
        const req = http.createHttp();
        req.request(url, {
            method: http.RequestMethod.GET,
            expectDataType: http.HttpDataType.ARRAY_BUFFER,
            connectTimeout: 8000,
            readTimeout: 8000
        }).then((res) => {
            if (res.responseCode === 200) {
                const ab = res.result;
                if (ab.byteLength > 0) {
                    const file = fs.openSync(filePath, fs.OpenMode.READ_WRITE | fs.OpenMode.CREATE | fs.OpenMode.TRUNC);
                    fs.writeSync(file.fd, ab);
                    fs.closeSync(file.fd);
                    this.evictTileCache();
                }
            }
        }).catch((e) => {
            hilog.error(DOMAIN, TAG, `Fetch tile failed: ${e.message}`);
        }).finally(() => {
            req.destroy();
            this.tileInflight.delete(key);
        });
    }
    /** ç¼“å­˜æ€»é‡è¶…ä¸Šé™æ—¶æŒ‰ä¿®æ”¹æ—¶é—´ä»æ—§åˆ°æ–°æ·˜æ±° */
    evictTileCache() {
        try {
            const names = fs.listFileSync(this.tileCacheDir);
            const stats = [];
            let total = 0;
            for (const name of names) {
                const st = fs.statSync(`${this.tileCacheDir}/${name}`);
                total += st.size;
                stats.push({ name, mtime: st.mtime, size: st.size });
            }
            if (total <= TILE_DISK_CACHE_BYTES) {
                return;
            }
            stats.sort((a, b) => a.mtime - b.mtime);
            for (const st of stats) {
                if (total <= TILE_DISK_CACHE_BYTES) {
                    break;
                }
                fs.unlinkSync(`${this.tileCacheDir}/${st.name}`);
                total -= st.size;
            }
        }
        catch (e) {
            hilog.error(DOMAIN, TAG, `Evict tile cache failed: ${e.message}`);
        }
    }
    /** é€‰ç‚¹ç»Ÿä¸€å…¥å£ï¼šåœ°å›¾ç‚¹æŒ‰ã€æ‹–åŠ¨é’ˆã€å®šä½ï¼›addressOverride éç©ºæ—¶ç›´æ¥ä½œä¸ºåœ°å€ */
    pickPosition(lat, lon, fly, addressOverride) {
        this.gcjLat = lat;
        this.gcjLon = lon;
        this.hasPicked = true;
        this.syncPin();
        if (fly) {
            this.flyTo(lat, lon, 16);
        }
        if (addressOverride !== '') {
            this.pickedAddress = addressOverride;
        }
        else {
            this.scheduleGeocode();
        }
    }
    /** æŒ‰å½“å‰é€‰ç‚¹çŠ¶æ€åŒæ­¥é’ˆä¸é•œå¤´ */
    applySelectionToMap() {
        if (!this.hasPicked) {
            return;
        }
        this.syncPin();
        this.flyTo(this.gcjLat, this.gcjLon, 16);
    }
    // ---------- UI ----------
    /** ç‚¹å‡»æ”¶è—é’ˆ/åˆ—è¡¨é¡¹ = é€‰ä¸­è¯¥æ”¶è— */
    selectFavorite(loc) {
        this.editingId = loc.id;
        this.noteInput = loc.note;
        this.pickedAddress = loc.address;
        const gcj = ChaoxingUtils.bd09_to_gcj02(ChaoxingUtils.parseStoredCoord(loc.latitude), ChaoxingUtils.parseStoredCoord(loc.longitude));
        this.pickPosition(gcj.lat, gcj.lon, true, loc.address);
    }
    /** å®šä½åˆ°å½“å‰ä½ç½®ï¼šä»…ç§»åŠ¨é•œå¤´ï¼Œä¸æ‰“æ ‡è®°ã€ä¸é€‰ç‚¹ */
    async locateCurrent() {
        try {
            const atManager = abilityAccessCtrl.createAtManager();
            const permissions = ['ohos.permission.APPROXIMATELY_LOCATION', 'ohos.permission.LOCATION'];
            const context = getContext(this);
            const result = await atManager.requestPermissionsFromUser(context, permissions);
            if (!result.authResults.every((r) => r === 0)) {
                promptAction.showToast({ message: 'æœªè·å¾—å®šä½æƒé™ï¼Œè¯·åœ¨ç³»ç»Ÿè®¾ç½®ä¸­å¼€å¯', duration: 1500 });
                return;
            }
        }
        catch (e) {
            hilog.error(DOMAIN, TAG, `Request location permission failed: ${e.message}`);
            promptAction.showToast({ message: 'å®šä½æƒé™è¯·æ±‚å¤±è´¥' });
            return;
        }
        this.gpsLocating = true;
        try {
            const location = await geoLocationManager.getCurrentLocation();
            const gcj = ChaoxingUtils.wgs84_to_gcj02(location.latitude, location.longitude);
            this.flyTo(gcj.lat, gcj.lon, 16);
        }
        catch (e) {
            hilog.error(DOMAIN, TAG, `Get current location failed: ${e.message}`);
            promptAction.showToast({ message: 'å®šä½å¤±è´¥ï¼Œè¯·æ£€æŸ¥å®šä½æœåŠ¡' });
        }
        finally {
            this.gpsLocating = false;
        }
    }
    scheduleGeocode() {
        if (this.geocodeTimer >= 0) {
            clearTimeout(this.geocodeTimer);
        }
        this.geocodeSeq++;
        const seq = this.geocodeSeq;
        this.geocodeTimer = setTimeout(() => {
            this.geocodeTimer = -1;
            this.reverseGeocode(seq);
        }, 500);
    }
    /** é€‰ç‚¹åå–åœ°å€ï¼›getAddressesFromLocation ä¸­å›½å¢ƒå†…æŒ‰ GCJ-02 è¯·æ±‚ */
    async reverseGeocode(seq) {
        try {
            const addresses = await geoLocationManager.getAddressesFromLocation({
                latitude: this.gcjLat,
                longitude: this.gcjLon,
                maxItems: 1
            });
            if (seq !== this.geocodeSeq) {
                return;
            }
            if (addresses.length > 0 && addresses[0].placeName) {
                this.pickedAddress = addresses[0].placeName;
            }
            else {
                this.pickedAddress = `${this.gcjLat.toFixed(6)}, ${this.gcjLon.toFixed(6)}`;
            }
            // åœ°å€å›å¡«ååˆ·æ–°é€‰ç‚¹é’ˆä¸Šæ–¹çš„æ ‡ç­¾
            this.syncPin();
        }
        catch (e) {
            hilog.error(DOMAIN, TAG, `Reverse geocode failed: ${e.message}`);
            if (seq !== this.geocodeSeq) {
                return;
            }
            this.pickedAddress = `${this.gcjLat.toFixed(6)}, ${this.gcjLon.toFixed(6)}`;
        }
    }
    rerender() {
        this.updateDirtyElements();
    }
}
