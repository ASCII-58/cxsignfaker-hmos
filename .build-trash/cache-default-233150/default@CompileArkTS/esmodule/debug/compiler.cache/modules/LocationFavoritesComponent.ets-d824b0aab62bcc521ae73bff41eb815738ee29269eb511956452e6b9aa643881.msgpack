  onMapReady() {
    this.webReady = true
    this.syncFavorites()
    if (this.hasPicked) {
      this.syncPin()
      this.flyTo(this.gcjLat, this.gcjLon, 16)
    } else {
      this.locateCurrent()
    }
  }

  /** ç‚¹æŒ‰åœ°å›¾é€‰ç‚¹ */
  onMapClick(lat: number, lon: number) {
    this.pickPosition(lat, lon, false, '')
  }

  /** æ‹–åŠ¨/ç‚¹æŒ‰é€‰ç‚¹é’ˆååŒæ­¥ä½ç½® */
  onPinDragEnd(lat: number, lon: number) {
    this.gcjLat = lat
    this.gcjLon = lon
    this.hasPicked = true
    this.scheduleGeocode()
