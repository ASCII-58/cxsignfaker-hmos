import { CourseAndActivity, ClassInfo } from '../utils/classFun';
import { DatabaseManager } from '../utils/DataBase';
import { loginFunction } from '../utils/Login';
import { image } from '@kit.ImageKit';
import { hilog } from '@kit.PerformanceAnalysisKit';


const TAG = 'SearchCoursePage';
const DOMAIN = 0x0007;

@Builder
export function init() {
  SearchLongTakeTransitionPageTwo()
}

// è¯¾ç¨‹é¡¹ç»„ä»¶
@Reusable
@Component
struct CourseItem {
  @Prop course: ClassInfo
  @State courseImage: image.PixelMap | null = null
  @State isPressed: boolean = false
  onCourseClick?: (course: ClassInfo) => void

  build() {
    Row() {
      if (this.courseImage) {
        Image(this.courseImage) .draggable(false)
          .width(44)
          .height(44)
          .borderRadius(12)
          .objectFit(ImageFit.Cover)
      } else {
        Column()
          .width(44)
          .height(44)
          .borderRadius(12)
          .backgroundColor($r('sys.color.ohos_id_color_component_normal'))
      }

      Column() {
        Text(this.course.name)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.primary_text'))
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })

        if (this.course.teacherfactor) {
          Text(`æ•™å¸ˆ: ${this.course.teacherfactor}`)
            .fontSize(13)
            .fontColor($r('app.color.secondary_text'))
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
      }
      .layoutWeight(1)
      .alignItems(HorizontalAlign.Start)
      .margin({ left: 12 })
    }
    .width('100%')
    .height(68)
    .padding({ left: 16, right: 16 })
    .scale({ x: this.isPressed ? 0.98 : 1, y: this.isPressed ? 0.98 : 1 })
    .animation({ duration: 150, curve: Curve.EaseInOut })
    .onTouch((event: TouchEvent) => {
      if (event.type === TouchType.Down) {
        this.isPressed = true
      } else if (event.type === TouchType.Up || event.type === TouchType.Cancel) {
        this.isPressed = false
      }
    })
    .onClick(() => {
      if (this.onCourseClick) {
        this.onCourseClick(this.course)
      }
    })
    .onAppear(async () => {
      if (this.course.imageURL) {
        try {
          this.courseImage = await loginFunction.GetPic(this.course.imageURL) as image.PixelMap
        } catch (e) {
          hilog.error(DOMAIN, TAG, 'Failed to load course image', e)
        }
      }
    })
  }
}

// [Start bind_id]
@Component
export default struct SearchLongTakeTransitionPageTwo {
  private pageInfos: NavPathStack = new NavPathStack();
  @State searchText: string = ''
  @State allCourses: ClassInfo[] = []
  @State filteredCourses: ClassInfo[] = []
  @State isLoading: boolean = false
  @StorageProp('cloneSessionCookies') cloneSessionCookies: string = ''

  async aboutToAppear() {
    await this.loadCourses()
  }

  async loadCourses() {
    this.isLoading = true
    try {
      const dbManager = DatabaseManager.getInstance()
      // å…‹éš†ç™»å½•æ—¶æœç´¢çš„æ˜¯å…‹éš†ç”¨æˆ·çš„è¯¾ç¨‹ï¼Œè¯¾ç¨‹åˆ—è¡¨è¯·æ±‚èµ°å…‹éš†ä¼šè¯
      const cookies = this.cloneSessionCookies !== ''
        ? this.cloneSessionCookies
        : (await dbManager.getUserByPosition(1, true))?.cookies

      if (cookies) {
        const result = await CourseAndActivity.getClassList(cookies)
        if (result.msg) {
          this.allCourses = result.classList
          this.filteredCourses = result.classList
        } else {
          promptAction.showToast({ message: 'è·å–è¯¾ç¨‹åˆ—è¡¨å¤±è´¥', duration: 2000 })
        }
      }
    } catch (e) {
      hilog.error(DOMAIN, TAG, 'Failed to load courses', e)
      promptAction.showToast({ message: 'åŠ è½½è¯¾ç¨‹å¤±è´¥', duration: 2000 })
    } finally {
      this.isLoading = false
    }
  }

  handleSearch(value: string) {
    this.searchText = value
    if (!value) {
      this.filteredCourses = this.allCourses
    } else {
      const searchLower = value.toLowerCase()
      this.filteredCourses = this.allCourses.filter(course =>
        course.name.toLowerCase().includes(searchLower) ||
        (course.teacherfactor && course.teacherfactor.toLowerCase().includes(searchLower))
      )
    }
  }

  handleCourseClick(course: ClassInfo): void {
    // è¿”å›ä¸Šä¸€é¡µå¹¶ä¼ é€’é€‰ä¸­çš„è¯¾ç¨‹ä¿¡æ¯

    // è¿™é‡Œå¯ä»¥æ·»åŠ å¯¼èˆªåˆ°è¯¾ç¨‹è¯¦æƒ…æˆ–ç­¾åˆ°é¡µé¢çš„é€»è¾‘
    this.pageInfos.pushPath({ name: 'ActivityListPage', param: course })
  }

  build() {
    NavDestination() {
      Column() {
        // æœç´¢æ 
        Row({ space: 12 }) {
          Column() {
            Image($r('app.media.arrow_right')) .draggable(false)
              .width(20).height(20)
              .fillColor($r('app.color.icon'))
              .rotate({ angle: 180 })
          }
          .width(40).height(40)
          .borderRadius(12)
          .backgroundColor($r('sys.color.ohos_id_color_button_normal'))
          .justifyContent(FlexAlign.Center)
          .onClick(() => { this.onArrowClicked(); })

          Search({ placeholder: 'æœç´¢è¯¾ç¨‹åç§°æˆ–æ•™å¸ˆ', value: $$this.searchText })
            .height(40)
            .placeholderColor($r('sys.color.ohos_id_color_text_secondary'))
            .layoutWeight(1)
            .borderRadius(20)
            .backgroundColor($r('sys.color.ohos_id_color_component_normal'))
            .geometryTransition('SEARCH_ONE_SHOT_DEMO_TRANSITION_ID')
            .defaultFocus(true)
            .focusOnTouch(true)
            .onSubmit((value: string) => {
              this.handleSearch(value)
            })
            .onChange((value: string) => {
              this.handleSearch(value)
            })
        }
        .width('100%')
        .height(64)
        .alignItems(VerticalAlign.Center)
        .padding({ left: 16, right: 16, top: 8, bottom: 8 })

        // æœç´¢ç»“æœ
        if (this.isLoading) {
          Column() {
            LoadingProgress()
              .width(48)
              .height(48)
              .color($r('app.color.icon'))
            Text('åŠ è½½ä¸­...')
              .fontSize(14)
              .fontColor($r('app.color.secondary_text'))
              .margin({ top: 12 })
          }
          .width('100%')
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
        } else if (this.filteredCourses.length === 0) {
          Column() {
            Image($r('app.media.ic_public_quit')) .draggable(false)
              .width(80)
              .height(80)
              .fillColor($r('app.color.secondary_text'))
              .margin({ bottom: 16 })
              .opacity(0.5)

            Text(this.searchText ? 'æœªæ‰¾åˆ°åŒ¹é…çš„è¯¾ç¨‹' : 'æš‚æ— è¯¾ç¨‹')
              .fontSize(16)
              .fontWeight(FontWeight.Medium)
              .fontColor($r('app.color.secondary_text'))

            if (this.searchText) {
              Text('æ¢ä¸ªå…³é”®è¯è¯•è¯•çœ‹')
                .fontSize(14)
                .fontColor($r('app.color.text_placeholder'))
                .margin({ top: 8 })
            }
          }
          .width('100%')
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
        } else {
          Column() {
            Text(`æ‰¾åˆ° ${this.filteredCourses.length} ä¸ªè¯¾ç¨‹`)
              .fontSize(14)
              .fontColor($r('app.color.secondary_text'))
              .width('100%')
              .padding({ left: 16, right: 16, bottom: 8 })

            List({ space: 0 }) {
              ForEach(this.filteredCourses, (course: ClassInfo, index: number) => {
                ListItem() {
                  CourseItem({
                    course: course,
                    onCourseClick: (c: ClassInfo) => this.handleCourseClick(c)
                  })
                }
              })
            }
            .divider({ strokeWidth: 0.5, color: $r('sys.color.comp_divider'), startMargin: 72, endMargin: 16 })
            .width('100%')
            .layoutWeight(1)
            .padding({ left: 0, right: 0 })
            .cachedCount(5)
            .scrollBar(BarState.Off)
          }
          .width('100%')
          .layoutWeight(1)
        }
      }
      .size({
        width: '100%',
        height: '100%'
      })
      .backgroundColor($r('app.color.page_background'))
    }
    .transition(TransitionEffect.OPACITY)
    .hideTitleBar(true)
    .backgroundColor($r('app.color.page_background'))
    .onReady((context: NavDestinationContext) => {
      this.pageInfos = context.pathStack;
    })
    .onBackPressed(() => {
      // è¿”å›æ—¶ä¹Ÿä½¿ç”¨åŠ¨ç”»
      this.getUIContext().animateTo({
        curve: curves.interpolatingSpring(0, 1, 342, 38)
      }, () => {
        this.pageInfos.pop(false);
      })
      return true;
    })
  }

  private onArrowClicked(): void {
    this.getUIContext().animateTo({
      curve: curves.interpolatingSpring(0, 1, 342, 38)
    }, () => {
      this.pageInfos.pop(false);
    })
  }
}
