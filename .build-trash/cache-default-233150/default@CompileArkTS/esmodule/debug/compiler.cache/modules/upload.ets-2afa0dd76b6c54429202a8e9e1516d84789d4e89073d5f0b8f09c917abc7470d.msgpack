async function applyExifOrientation(pixelMap, orientation) {
    switch (orientation) {
        case 2:
            await pixelMap.flip(true, false);
            break;
        case 3:
            await pixelMap.rotate(180);
            break;
        case 4:
            await pixelMap.flip(false, true);
            break;
        case 5:
            await pixelMap.rotate(90);
            await pixelMap.flip(true, false);
            break;
        case 6:
            await pixelMap.rotate(90);
            break;
        case 7:
            await pixelMap.rotate(270);
