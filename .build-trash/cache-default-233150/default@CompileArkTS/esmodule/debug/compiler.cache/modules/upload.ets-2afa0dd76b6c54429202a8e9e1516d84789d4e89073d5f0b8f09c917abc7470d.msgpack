        }
        finally {
            fs.closeSync(file);
        }
        hilog.info(DOMAIN, TAG, 'image randomized: %dx%d -> crop(%d,%d,%dx%d) q%d', srcW, srcH, cropX, cropY, cropWidth, cropHeight, quality);
