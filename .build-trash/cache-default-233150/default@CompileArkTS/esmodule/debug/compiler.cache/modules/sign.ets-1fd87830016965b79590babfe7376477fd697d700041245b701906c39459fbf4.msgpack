    }
    if (raw === 'success2') {
        return { kind: 'ended', message: 'è¿Ÿåˆ°æˆ–ç­¾åˆ°å·²ç»“æŸ', needCaptcha: false };
    }
    if (raw === 'ç­¾åˆ°å¤±è´¥ï¼Œè¯·é‡æ–°æ‰«æã€‚') {
        return { kind: 'qrcodeExpired', message: 'ç­¾åˆ°äºŒç»´ç å·²è¿‡æœŸï¼Œè¯·é‡æ–°æ‰«ç ', needCaptcha: false };
    }
    if (raw.startsWith('errorLocation')) {
        const distance = parseFloat(raw.split('_')[1]);
        let message = 'ä½ç½®ä¸åœ¨è®¾ç½®èŒƒå›´å†…';
        if (!isNaN(distance)) {
            message += `ï¼Œè·ç¦»ç­¾åˆ°ç‚¹${distance}ç±³`;
        }
        return { kind: 'wrongPosition', message: message, needCaptcha: false };
    }
    if (raw === 'æ‚¨å·²ç­¾åˆ°è¿‡äº†') {
        return { kind: 'already', message: 'æ‚¨å·²ç­¾åˆ°è¿‡äº†', needCaptcha: false };
    }
    if (raw.startsWith('validate')) {
        return { kind: 'captcha', message: 'éœ€è¦éªŒè¯ç ', needCaptcha: true };
    }
    if (raw.includes('<html') || raw.includes('500 Internal Server Error')) {
        return { kind: 'error', message: 'æœåŠ¡ç«¯é”™è¯¯ (500)', needCaptcha: false };
    }
    return { kind: 'error', message: raw, needCaptcha: false };
}
