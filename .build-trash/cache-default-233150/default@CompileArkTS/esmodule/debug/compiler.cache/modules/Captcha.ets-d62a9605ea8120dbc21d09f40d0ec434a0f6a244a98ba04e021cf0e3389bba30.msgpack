  /** å¼¹å±‚å¤ç”¨æ¢ç”¨æˆ·ï¼šé‡ç½®ä¸€æ¬¡æ€§çŠ¶æ€åæŒ‰æ–°ç”¨æˆ·é‡æ–°æ‹‰å–ï¼›é¦–æ¬¡æŒ‚è½½èµ° aboutToAppearï¼Œä¸ä¼šè§¦å‘æœ¬å›è°ƒ */
  onCaptchaSessionChanged() {
    this.modelTried = false
