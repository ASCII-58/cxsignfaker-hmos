    }
    this.isLoading = true
    this.errMsg = ''
    this.sliderValue = 0
    this.autoStatus = ''
    this.resultHint = ''
    this.resultOk = false
    this.info.token = '' // ç«‹å³æ¸…ç©ºæ—§å›¾ï¼šåˆ‡æ¢ç”¨æˆ·/åˆ·æ–°æ—¶ä¸é—ªç°ä¸Šä¸€ä½çš„éªŒè¯ç 
    this.contentOpacity = 0 // æ·¡å‡ºæ—§å†…å®¹
    await this.delay(220)
    try {
      if (this.demoMode) {
        await this.runDemoFlow()
        return
      }
      this.info = await CaptchaApi.getCaptchaPhotos(this.captchaUser.refererParams, this.captchaUser.cookies)
      this.contentOpacity = 1 // å›¾ç‰‡å°±ç»ªå³æ·¡å…¥ï¼Œæ¨¡å‹è¯†åˆ«æœŸé—´ä¿æŒå¯è§
      this.autoStatus = 'æ­£åœ¨è‡ªåŠ¨æ ¡éªŒâ€¦'
      const memoryFinished = await this.tryMemoryCheck()
      const useModel = !memoryFinished && this.modelCaptchaEnabled && !this.modelTried
      if (useModel) {
        await this.tryModelCheck()
      } else {
        this.autoStatus = ''
      }
    } catch (e) {
      hilog.error(DOMAIN, TAG, `Load captcha failed: ${(e as Error).message}`)
