  /** æ¢ç”¨æˆ·åˆ‡æ¢åŠ¨ç”»ï¼šå†…å®¹åŒºæ·¡å‡º/æ·¡å…¥ */
  @State contentOpacity: number = 1
  /** è®¾ç½®é¡µ Beta å¼€å…³ï¼šå¯ç”¨åæ‹‰å–éªŒè¯ç æ—¶ç›´æ¥ç”¨æœ¬åœ°æ¨¡å‹å®Œæˆæ»‘å—éªŒè¯ */
  private modelCaptchaEnabled: boolean = false
  /** æ¨¡å‹æ¯æ¬¡å¼¹å‡ºéªŒè¯ç åªè‡ªåŠ¨å°è¯•ä¸€æ¬¡ï¼Œå¤±è´¥åå›é€€æ‰‹åŠ¨ï¼Œé¿å…å¤±è´¥å¾ªç¯ */
  private modelTried: boolean = false
