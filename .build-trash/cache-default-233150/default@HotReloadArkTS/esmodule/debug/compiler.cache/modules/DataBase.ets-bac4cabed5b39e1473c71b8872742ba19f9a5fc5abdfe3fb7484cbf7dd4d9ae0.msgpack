        }
        catch (err) {
            const error = err;
            console.error(`è·å–è¡¨ ${tableName} è®°å½•æ•°å¤±è´¥. é”™è¯¯ç : ${error.code}, æ¶ˆæ¯: ${error.message}`);
            throw new Error(`æ— æ³•è·å–è¡¨è®°å½•æ•°: ${error.message}`);
        }
