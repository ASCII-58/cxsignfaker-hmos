    async getTableCount(tableName) {
        // éªŒè¯è¡¨ååˆæ³•æ€§ï¼Œé˜²æ­¢SQLæ³¨å…¥
        const allowedTables = ['HostUser', 'OtherUser', 'SignRecord'];
        if (!allowedTables.includes(tableName)) {
            throw new Error(`æ— æ•ˆçš„è¡¨å: ${tableName}. å…è®¸çš„è¡¨: ${allowedTables.join(', ')}`);
        }
        if (!this.rdbStore) {
            throw new Error('æ•°æ®åº“æœªåˆå§‹åŒ–ã€‚è¯·å…ˆè°ƒç”¨init()æ–¹æ³•ã€‚');
        }
        try {
