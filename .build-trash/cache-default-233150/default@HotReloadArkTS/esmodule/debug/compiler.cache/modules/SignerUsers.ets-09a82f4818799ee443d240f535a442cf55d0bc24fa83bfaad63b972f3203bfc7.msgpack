import { hilog } from '@kit.PerformanceAnalysisKit';
import { DatabaseManager, UserDataAndId } from '../utils/DataBase';
import { loginFunction } from '../utils/Login';

const TAG = 'SignerUsers';
const DOMAIN = 0x0012;

/** ä¼šè¯çº§å¤´åƒç¼“å­˜ï¼šuserId â†’ å¤´åƒã€‚é¿å…æ¯æ¬¡æ‰“å¼€é€‰æ‹©åˆ—è¡¨éƒ½é‡æ–°èµ° DB + ç½‘ç»œä¸‹è½½ */
const avatarCache = new Map<number, image.PixelMap>();

/** ç­¾åˆ°ç”¨æˆ·é€‰æ‹©åˆ—è¡¨ä¸­çš„ç”¨æˆ·é¡¹ */
export interface userMenu {
  uname: string
  id: number
  SignPermission: number
}

/** ç­¾åˆ°ç”¨æˆ·å¤´åƒ */
@Reusable
@Component
export struct Icon {
  @Prop UserId: number;
  @State ImageData: image.PixelMap | null = null;
  @State isLoaded: boolean = false;

  build() {
    Stack() {
      if (this.ImageData) {
        Image(this.ImageData) .draggable(false)
          .width(48)
          .height(48)
          .borderRadius(24) // åœ†å½¢
          .objectFit(ImageFit.Cover)
          .border({ width: 1, color: $r('sys.color.comp_divider') }) // ç³»ç»Ÿåˆ†å‰²çº¿é¢œè‰²
      } else {
        // åŠ è½½å ä½å›¾
        Circle({ width: 48, height: 48 })
          .fill($r('sys.color.ohos_id_color_component_normal')) // ç³»ç»Ÿç»„ä»¶é»˜è®¤è‰²
      }
    }
    .margin({ right: 12 })
    .onAppear(async () => {
      const cached = avatarCache.get(this.UserId);
      if (cached) {
        this.ImageData = cached;
        this.isLoaded = true;
        return;
      }
      try {
        const userData = await DatabaseManager.getInstance().getUserById(this.UserId);
        if (userData) {
          const url = (await loginFunction.getUserInfo(userData.cookies)).pic
          const pic = await loginFunction.GetPic(url)
          if (pic) {
            this.ImageData = pic;
            avatarCache.set(this.UserId, pic);
            this.isLoaded = true;
          }
        }
      } catch (e) {
        hilog.error(DOMAIN, TAG, `[Icon] Load failed for user ${this.UserId}: %{public}s`,
          (e as Error).message);
      }
    })
  }
}

/** ç­¾åˆ°ç”¨æˆ·åˆ—è¡¨é¡¹ï¼ˆå‹¾é€‰ä»£ç­¾ç”¨æˆ·ï¼‰ */
@Reusable
@Component
export struct userItem {
  @State bgColor: Resource = $r('sys.color.ohos_id_color_card_bg'); // é»˜è®¤å¡ç‰‡èƒŒæ™¯
  @Prop user: userMenu
  @Link @Watch('onSelectionChange') signIdArray: number[]

  onSelectionChange() {
    // é€‰ä¸­çŠ¶æ€ç”± Checkbox å‘ˆç°ï¼Œæ­¤å¤„é¢„ç•™è”åŠ¨
  }

  private permissionText(): string {
    if (this.user.SignPermission === 1) {
      return 'å¯ç­¾åˆ°';
    }
    if (this.user.SignPermission === 0) {
      return 'å·²ç­¾åˆ°';
    }
    if (this.user.SignPermission === 2) {
      return 'å·²æˆªæ­¢';
    }
    return 'æ— æƒé™(å¯å¼ºåˆ¶é‡ç­¾)';
  }

  build() {
    Row() {
      Icon({ UserId: this.user.id })

      Column() {
        Text(this.user.uname)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('sys.color.ohos_id_color_text_primary'))

        Text(this.permissionText())
          .fontSize(12)
          .fontColor(this.user.SignPermission === 1 ? $r('sys.color.ohos_id_color_text_secondary') :
            $r('sys.color.ohos_id_color_warning'))
          .margin({ top: 4 })
      }
      .alignItems(HorizontalAlign.Start)
      .layoutWeight(1)

      // ä½¿ç”¨ Checkbox ä»£æ›¿çº¯èƒŒæ™¯è‰²å˜åŒ–ï¼Œäº¤äº’æ›´æ˜ç¡®
      Checkbox()
        .select(this.signIdArray.includes(this.user.id))
        .selectedColor($r('sys.color.ohos_id_color_connected'))
        .hitTestBehavior(HitTestMode.None) // è®©ç‚¹å‡»äº‹ä»¶ç©¿é€åˆ° Row
    }
    .width('100%')
    .padding(12)
    .backgroundColor(this.bgColor)
    .borderRadius(12)
    .margin({ bottom: 8 })
  }
}
