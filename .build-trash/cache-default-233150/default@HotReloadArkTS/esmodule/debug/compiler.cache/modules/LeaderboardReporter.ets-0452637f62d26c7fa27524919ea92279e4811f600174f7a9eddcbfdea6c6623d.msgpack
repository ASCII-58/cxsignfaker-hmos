     * åªä¸ŠæŠ¥ä¸Šæ¬¡æˆåŠŸåŒæ­¥æ°´ä½çº¿ä¹‹åçš„è®°å½•ï¼Œæœ¬æ‰¹å…¨éƒ¨æˆåŠŸæ‰æ¨è¿›æ°´ä½çº¿ï¼›
     * æ˜ å°„æ•´ä½“å¤±è´¥ï¼ˆå¦‚ cookies å…¨éƒ¨è¿‡æœŸï¼‰æ—¶ synced ä¸º 0ï¼Œæ°´ä½çº¿ä¿æŒä¸åŠ¨ï¼Œ
     * å¾… EntryAbility å¯åŠ¨åˆ·æ–° cookies åä¸‹æ¬¡å¯åŠ¨è‡ªåŠ¨é‡è¯•ã€‚fire-and-forgetï¼Œå¤±è´¥ä»…è®°æ—¥å¿—ã€‚
     */
    static async autoSyncNewRecords(context) {
        if (AppStorage.get('lbSyncEnabled') === false) {
            return;
        }
        try {
            const pref = await preferences.getPreferences(context, 'settings');
            const watermark = await pref.get(PREF_LAST_SYNC_KEY, 0);
            const records = (await DatabaseManager.getInstance().getAllSignRecords())
                .filter((record) => record.createTime > watermark);
            if (records.length === 0) {
