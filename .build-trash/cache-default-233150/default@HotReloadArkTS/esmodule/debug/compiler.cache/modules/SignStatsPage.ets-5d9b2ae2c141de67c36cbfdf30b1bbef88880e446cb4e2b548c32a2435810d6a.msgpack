        .fontColor($r('app.color.primary_text'))
        .maxLines(1)
      Text(label)
        .fontSize(12).fontColor($r('app.color.secondary_text'))
        .margin({ top: 4 })
    }
    .layoutWeight(1).alignItems(HorizontalAlign.Center)
  }

  @Builder
  TypeCard() {
    Column() {
      Text('ç­¾åˆ°ç±»åž‹åˆ†å¸ƒ')
        .fontSize(16).fontWeight(FontWeight.Medium)
        .fontColor($r('app.color.primary_text')).width('100%')
      ForEach(this.stats?.typeCounts ?? [], (t: SignTypeCount) => {
        Column() {
          Row() {
            Text(signTypeLabel(t.signType))
              .fontSize(13).fontColor($r('app.color.primary_text'))
            Blank()
            Text(`${t.count} æ¬¡`)
              .fontSize(12).fontColor($r('app.color.secondary_text'))
          }
          .width('100%')
          Progress({ value: t.count, total: this.maxTypeCount(), type: ProgressType.Linear })
            .width('100%').height(6).margin({ top: 6 })
            .color($r('app.color.selected'))
            .backgroundColor($r('app.color.class_icon_border'))
        }
        .margin({ top: 10 }).width('100%')
      }, (t: SignTypeCount) => t.signType)
    }
    .alignItems(HorizontalAlign.Start)
    .padding(14).width('100%')
    .backgroundColor($r('app.color.card_background'))
    .borderRadius(14)
  }

  @Builder
  HistoryCard() {
    Column() {
      Row() {
        Text('æœ€è¿‘è®°å½•')
          .fontSize(16).fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.primary_text')).layoutWeight(1)
        Text(`${this.records.length} æ¡`)
          .fontSize(12).fontColor($r('app.color.secondary_text'))
      }
      .width('100%')

      ForEach(this.records, (record: SignRecord, index: number) => {
        Column() {
          if (index > 0) {
            Divider()
              .color($r('app.color.class_icon_border'))
              .margin({ top: 8 })
          }
          this.RecordItem(record)
        }
        .width('100%').margin({ top: 8 })
      }, (record: SignRecord) => record.id.toString())
    }
    .alignItems(HorizontalAlign.Start)
    .padding(14).width('100%')
    .backgroundColor($r('app.color.card_background'))
    .borderRadius(14)
  }

  @Builder
  RecordItem(record: SignRecord) {
    Row() {
      Text('â—')
        .fontSize(12).fontColor(this.kindColor(record.kind))
      Column() {
        Row() {
          Text(record.uname)
            .fontSize(15).fontWeight(FontWeight.Medium)
            .fontColor($r('app.color.primary_text'))
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
          if (record.action === 'signout') {
            Text('ç­¾é€€')
              .fontSize(10).fontColor($r('app.color.selected'))
              .padding({ left: 6, right: 6, top: 2, bottom: 2 })
              .backgroundColor($r('app.color.accent_soft_bg'))
              .borderRadius(8)
              .margin({ left: 6 })
          }
          Blank()
          Text(formatTime(record.createTime))
            .fontSize(11).fontColor($r('app.color.secondary_text'))
        }
        .width('100%')

        Text(`${signTypeLabel(record.signType)} Â· ${record.activityName !== '' ? record.activityName : 'æœªçŸ¥æ´»åŠ¨'}`)
          .fontSize(12).fontColor($r('app.color.secondary_text'))
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
          .margin({ top: 3 }).width('100%')

        Text(record.message)
          .fontSize(12).fontColor(this.kindColor(record.kind))
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
          .margin({ top: 3 }).width('100%')
      }
      .layoutWeight(1)
      .alignItems(HorizontalAlign.Start)
      .margin({ left: 8 })
    }
    .width('100%')
    .alignItems(VerticalAlign.Top)
  }

  build() {
    // HdsNavDestinationï¼ˆé¦–é¡µ/æ´»åŠ¨åˆ—è¡¨åŒæ¬¾æ‚¬æµ®æ ‡é¢˜æ ï¼‰ï¼šæ— çº§æ¸å˜æ¨¡ç³Šéšåˆ—è¡¨æ»šåŠ¨è¿žç»­å˜åŒ–
    HdsNavDestination() {
      if (this.isLoading) {
        Column() {
          LoadingProgress()
            .width(44).height(44)
            .color($r('app.color.icon'))
        }
        .width('100%').height('100%')
        .justifyContent(FlexAlign.Center)
      } else if (!this.stats || (this.stats.signTotal === 0 && this.stats.signOutSuccess === 0 &&
        this.records.length === 0)) {
        Column() {
          Text('æš‚æ— ç­¾åˆ°ç»Ÿè®¡')
            .fontSize(16).fontColor($r('app.color.primary_text'))
          Text('å®Œæˆç­¾åˆ°åŽï¼Œè¿™é‡Œå°†å±•ç¤ºç­¾åˆ°æˆåŠŸçŽ‡ä¸ŽåŽ†å²è®°å½•')
            .fontSize(13).fontColor($r('app.color.secondary_text'))
            .margin({ top: 8 })
        }
        .width('100%').height('100%')
        .justifyContent(FlexAlign.Center)
      } else {
        List({ space: 0, scroller: this.listScroller }) {
          // è®©ä½æ ‡é¢˜æ çš„ç©ºç™½åšæˆåˆ—è¡¨é¦–é¡¹ï¼ˆéšå†…å®¹æ»šåŠ¨æ”¶èµ·ï¼Œä¿è¯æ ‡é¢˜æ æ¸å˜æ¨¡ç³Šç”Ÿæ•ˆï¼Œé¦–é¡µåŒæ¬¾ï¼‰
          ListItem() {
            Column().height(this.statusBarHeight + 56)
          }.width('100%')
          ListItem() {
            this.SummaryCard()
          }.width('100%').padding({ left: 16, right: 16 })
          if (this.stats && this.stats.typeCounts.length > 0) {
            ListItem() {
              this.TypeCard()
            }.width('100%').padding({ left: 16, right: 16 }).margin({ top: 10 })
          }
          if (this.records.length > 0) {
            ListItem() {
              this.HistoryCard()
            }.width('100%').padding({ left: 16, right: 16 }).margin({ top: 10 })
            ListItem() {
              Button(this.isSyncing ? 'åŒæ­¥ä¸­...' : 'åŒæ­¥è®°å½•åˆ°äº‘ç«¯')
                .width('100%').height(46).borderRadius(23)
                .fontSize(16)
                .backgroundColor($r('app.color.card_background'))
                .fontColor($r('app.color.selected'))
                .enabled(!this.isSyncing)
                .onClick(() => {
                  this.syncToCloud()
                })
            }.width('100%').padding({ left: 16, right: 16 }).margin({ top: 16 })
            ListItem() {
              Button('æ¸…ç©ºç»Ÿè®¡è®°å½•')
                .width('100%').height(46).borderRadius(23)
                .fontSize(16)
                .backgroundColor($r('app.color.card_background'))
                .fontColor($r('app.color.unsignable'))
                .onClick(() => {
                  this.confirmClearRecords()
                })
            }.width('100%').padding({ left: 16, right: 16 }).margin({ top: 10 })
          }
          ListItem() {
            Column().height(24)
          }.width('100%')
        }
        .width('100%').height('100%')
        .scrollBar(BarState.Off)
      }
    }
    .height('100%')
    .width('100%')
    .backgroundColor($r('app.color.page_background'))
    .titleBar({
      content: {
        title: { mainTitle: 'ç­¾åˆ°ç»Ÿè®¡' },
        menu: { // å³ä¸Šè§’æ¸…ç©ºå…¥å£ï¼ˆå®˜æ–¹ç¤ºä¾‹åŒæ¬¾æ ‡é¢˜æ èœå•ï¼‰
          value: [{
            content: {
              icon: $r('app.media.ic_public_delete'),
              label: 'æ¸…ç©ºç­¾åˆ°ç»Ÿè®¡',
              action: () => {
                this.confirmClearRecords();
              }
            }
          }]
        }
      },
      style: {
        scrollEffectOpts: { // ç³»ç»Ÿçº§æ— çº§æ¸å˜æ¨¡ç³Šï¼ˆé¦–é¡µåŒæ¬¾ï¼‰ï¼šæ¨¡ç³Šé‡éšåˆ—è¡¨æ»šåŠ¨è¿žç»­å˜åŒ–
          enableScrollEffect: true,
          scrollEffectType: ScrollEffectType.GRADIENT_BLUR,
          blurEffectiveEndOffset: LengthMetrics.vp(this.statusBarHeight + 56)
        },
        systemMaterialEffect: this.supportFloatingBar ? { // æ²‰æµ¸å…‰æ„Ÿæè´¨ï¼ˆé¦–é¡µåŒæ¬¾ï¼‰ï¼Œ6.0 èµ°é»˜è®¤æ ·å¼
          materialType: HDS_MATERIAL_TYPE_ADAPTIVE as hdsMaterial.MaterialType,
          materialLevel: HDS_MATERIAL_LEVEL_GENTLE as hdsMaterial.MaterialLevel
        } : undefined
      },
      avoidLayoutSafeArea: false,
      enableComponentSafeArea: false
    })
    .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.TOP, LayoutSafeAreaEdge.BOTTOM]) // å†…å®¹é“ºæ»¡çŠ¶æ€æ å’Œæ‰‹åŠ¿æ¡ä¹‹ä¸‹
    .bindToScrollable([this.listScroller]) // æ ‡é¢˜æ æ¨¡ç³Šç»‘å®šåˆ—è¡¨æ»šåŠ¨
    .onReady((ctx: NavDestinationContext) => {
      this.pathInfos = ctx.pathStack;
    })
    .onAppear(() => {
      this.loadData()
    })
  }
}
