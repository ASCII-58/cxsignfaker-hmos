function signTypeLabel(signType: string): string {
  if (signType === '0') {
    return 'æ™®é€š/æ‹ç…§'
  } else if (signType === '2') {
    return 'æ‰«ç '
  } else if (signType === '3') {
    return 'æ‰‹åŠ¿'
  } else if (signType === '4') {
    return 'ä½ç½®'
  } else if (signType === '5') {
    return 'ç­¾åˆ°ç '
  }
  return 'å…¶ä»–'
}

/** è®°å½•æ—¶é—´æ ¼å¼åŒ–ï¼šyyyy-MM-dd HH:mm */
function formatTime(createTime: number): string {
  const d = new Date(createTime)
  const pad = (n: number): string => n < 10 ? `0${n}` : `${n}`
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ` +
    `${pad(d.getHours())}:${pad(d.getMinutes())}`
}

@Builder
export function initSignStats(name: string) {
  SignStatsPage()
}

/**
 * ç­¾åˆ°ç»Ÿè®¡é¡µï¼šæ±‡æ€»ï¼ˆæ¬¡æ•°/æˆåŠŸ/å¤±è´¥/æˆåŠŸçŽ‡/ç­¾é€€ï¼‰+ ç­¾åˆ°ç±»åž‹åˆ†å¸ƒ + æœ€è¿‘è®°å½•
 * æ•°æ®æ¥è‡ªæœ¬åœ° SignRecord è¡¨ï¼ˆSignerPage æ¯æ¬¡ç­¾åˆ°/ç­¾é€€é€ç”¨æˆ·è½åº“ï¼‰ï¼›
 * æ”¯æŒä¸€é”®æŠŠæœ¬åœ°è®°å½•è¡¥å½•åˆ°äº‘ç«¯æŽ’è¡Œæ¦œï¼ˆLeaderboardReporter.syncHistoryToCloudï¼‰
 */
@Component
struct SignStatsPage {
  @State stats: SignStats | null = null;
  @State records: SignRecord[] = [];
  @State isLoading: boolean = true;
  @State isSyncing: boolean = false;
  @StorageProp('statusBarHeight') statusBarHeight: number = 0; // EntryAbility å®žæµ‹çš„çŠ¶æ€æ é«˜åº¦
  private pathInfos: NavPathStack = new NavPathStack();
  private listScroller: Scroller = new Scroller(); // æ ‡é¢˜æ æ¸å˜æ¨¡ç³Šçš„æ»šåŠ¨ç»‘å®šæº
  // 6.1(23) èµ·æ”¯æŒæ²‰æµ¸å…‰æ„Ÿæè´¨ï¼Œä½Žç‰ˆæœ¬ç³»ç»Ÿèµ°é»˜è®¤æ ·å¼ï¼ˆé¦–é¡µåŒæ¬¾ï¼‰
  private readonly supportFloatingBar: boolean = deviceInfo.sdkApiVersion >= 23

  /** æ±‡æ€»æˆåŠŸçŽ‡ï¼ˆæ— è®°å½•æ—¶æ˜¾ç¤ºå ä½ç¬¦ï¼‰ */
  private successRate(): string {
    if (!this.stats || this.stats.signTotal === 0) {
      return '--'
    }
    return `${Math.round(this.stats.signSuccess * 100 / this.stats.signTotal)}%`
  }

  /** ç±»åž‹åˆ†å¸ƒæ¡å½¢å›¾çš„æœ€å¤§å€¼ï¼ˆåšåˆ†æ¯ï¼Œé¿å…é™¤é›¶ï¼‰ */
  private maxTypeCount(): number {
    let max = 1
    this.stats?.typeCounts.forEach((t: SignTypeCount) => {
      if (t.count > max) {
        max = t.count
      }
    })
    return max
  }

  /** ç»“æžœ kind â†’ å±•ç¤ºé¢œè‰²ï¼šæˆåŠŸç»¿ / å·²ç­¾åˆ°ç¥ç€ / å…¶ä½™çº¢ */
  private kindColor(kind: string): Resource {
    if (kind === 'success') {
      return $r('app.color.signed')
    } else if (kind === 'already') {
      return $r('app.color.beta_badge')
    }
    return $r('app.color.unsignable')
  }

  private async loadData() {
    this.isLoading = true
    try {
      const db = DatabaseManager.getInstance()
      this.stats = await db.getSignStats()
      this.records = await db.getSignRecords(HISTORY_LIMIT)
    } catch (e) {
      hilog.error(DOMAIN, TAG, `Failed to load sign stats: ${(e as Error).message}`)
      promptAction.showToast({ message: 'ç­¾åˆ°ç»Ÿè®¡åŠ è½½å¤±è´¥' })
    } finally {
      this.isLoading = false
    }
  }

  private confirmClearRecords() {
    AlertDialog.show({
      title: 'æ¸…ç©ºç­¾åˆ°ç»Ÿè®¡',
      message: 'å°†åˆ é™¤å…¨éƒ¨æœ¬åœ°ç­¾åˆ°ç»Ÿè®¡è®°å½•ï¼Œä¸”æ— æ³•æ¢å¤ï¼Œæ˜¯å¦ç»§ç»­ï¼Ÿ',
      primaryButton: {
        value: 'å–æ¶ˆ',
        action: () => {
        }
      },
      secondaryButton: {
        value: 'æ¸…ç©º',
        action: async () => {
          try {
            await DatabaseManager.getInstance().clearSignRecords()
            await this.loadData()
            promptAction.showToast({ message: 'å·²æ¸…ç©ºç­¾åˆ°ç»Ÿè®¡' })
          } catch (e) {
            hilog.error(DOMAIN, TAG, `Failed to clear sign records: ${(e as Error).message}`)
            promptAction.showToast({ message: 'æ¸…ç©ºå¤±è´¥' })
          }
        }
      }
    })
  }

  /** æœ¬åœ°è®°å½•è¡¥å½•åˆ°äº‘ç«¯æŽ’è¡Œæ¦œï¼šæŒ‰åŽŸå§‹è½åº“æ—¶é—´ä¸ŠæŠ¥ï¼Œè®¡åˆ†ç”± Worker å”¯ä¸€ç´¢å¼•åŽ»é‡ */
  private async syncToCloud() {
    if (this.isSyncing) {
      return
    }
    this.isSyncing = true
    try {
      const outcome = await LeaderboardReporter.syncHistoryToCloud()
      promptAction.showToast({
        message: `äº‘åŒæ­¥å®Œæˆï¼šæˆåŠŸ ${outcome.synced} æ¡ï¼Œè·³è¿‡ ${outcome.skipped} æ¡ï¼Œå¤±è´¥ ${outcome.failed} æ¡`,
        duration: 3000
      })
    } catch (e) {
      hilog.error(DOMAIN, TAG, `Cloud sync failed: ${(e as Error).message}`)
      promptAction.showToast({ message: `äº‘åŒæ­¥å¤±è´¥ï¼š${(e as Error).message}` })
    } finally {
      this.isSyncing = false
    }
  }

  @Builder
  SummaryCard() {
    Column() {
      Text('æ±‡æ€»')
        .fontSize(16).fontWeight(FontWeight.Medium)
        .fontColor($r('app.color.primary_text')).width('100%')
      Row() {
        this.SummaryItem(`${this.stats?.signTotal ?? 0}`, 'ç­¾åˆ°æ¬¡æ•°')
        this.SummaryItem(`${this.stats?.signSuccess ?? 0}`, 'æˆåŠŸ')
        this.SummaryItem(`${this.stats?.signFailed ?? 0}`, 'å¤±è´¥')
        this.SummaryItem(this.successRate(), 'æˆåŠŸçŽ‡')
      }
      .width('100%').margin({ top: 12 })

      Text(`å·²ç­¾åˆ°(é‡å¤) ${this.stats?.signAlready ?? 0} æ¬¡ Â· ç­¾é€€æˆåŠŸ ${this.stats?.signOutSuccess ?? 0} æ¬¡`)
        .fontSize(12).fontColor($r('app.color.secondary_text'))
        .width('100%').margin({ top: 10 })
    }
    .alignItems(HorizontalAlign.Start)
    .padding(14).width('100%')
