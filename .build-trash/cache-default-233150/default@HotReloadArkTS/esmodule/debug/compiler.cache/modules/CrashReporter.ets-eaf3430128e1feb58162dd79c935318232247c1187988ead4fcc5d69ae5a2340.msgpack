    removeFaultLogs(info.params as Record<string, Object>);
  }
}

/**
 * Debug é¢æ¿ã€Œå‘é€æµ‹è¯•æŠ¥å‘Šã€ï¼šä¸åˆ¶é€ å´©æºƒï¼Œç›´æ¥å‘é€ä¸€æ¡æµ‹è¯•è´Ÿè½½åˆ° Workerï¼Œ
 * ç‹¬ç«‹éªŒè¯ URL/å£ä»¤/JSON/é‚®ä»¶é“¾è·¯ï¼ˆä¸çœŸå®å´©æºƒä¸ŠæŠ¥èµ°å®Œå…¨ç›¸åŒçš„ POSTï¼‰ã€‚
 * å¤±è´¥æ—¶æŠ›å‡ºå¼‚å¸¸ï¼Œç”±è°ƒç”¨æ–¹å±•ç¤ºã€‚
 */
export async function sendTestCrashReport(): Promise<void> {
  if (WORKER_URL.includes('REPLACE')) {
    setStatus('WORKER_URL æœªé…ç½®ï¼Œä¸ŠæŠ¥å…³é—­');
    throw new Error('WORKER_URL æœªé…ç½®ï¼Œä¸ŠæŠ¥å…³é—­');
  }
  const payload: CrashPayload = {
    app: 'link-test',
    version: 'debug',
    crash_type: 'JsError',
    time: new Date().toISOString(),
    uuid: `test-${Date.now()}`,
    foreground: 'yes',
    device: `${deviceInfo.marketName} ${deviceInfo.productModel}`,
    os: deviceInfo.osFullName,
    name: 'LinkTest',
    message: 'Debug é¢æ¿å‘é€é“¾è·¯æµ‹è¯•ï¼ˆéçœŸå®å´©æºƒï¼‰',
    stack: '',
    hilog: ''
  };
  const ok = await sendPayload(payload);
  if (!ok) {
    throw new Error('å‘é€å¤±è´¥ï¼Œè¯¦è§å´©æºƒä¸ŠæŠ¥çŠ¶æ€è¡Œ');
  }
}

/**
 * å´©æºƒé‚®ä»¶ä¸ŠæŠ¥ï¼š
 * é€šè¿‡ HiAppEvent è®¢é˜…ç³»ç»Ÿ APP_CRASH äº‹ä»¶ï¼ˆè¦†ç›– JsError ä¸ NativeCrashï¼‰ã€‚
 * å´©æºƒäº‹ä»¶ç”±ç³»ç»Ÿ faultlogger è½ç›˜ã€åœ¨ä¸‹æ¬¡å¯åŠ¨æ³¨å†Œ watcher åå›è°ƒï¼Œæ•…é‚®ä»¶åœ¨ç”¨æˆ·å†æ¬¡æ‰“å¼€åº”ç”¨æ—¶é€è¾¾ã€‚
 */
export class CrashReporter {
  static init(): void {
    if (WORKER_URL.includes('REPLACE')) {
      hilog.warn(DOMAIN, TAG, 'WORKER_URL not configured, crash reporting disabled');
      setStatus('WORKER_URL æœªé…ç½®ï¼Œä¸ŠæŠ¥å…³é—­');
      return;
    }
    try {
      hiAppEvent.addWatcher({
        name: 'crashMailWatcher',
        appEventFilters: [
          { domain: hiAppEvent.domain.OS, names: [hiAppEvent.event.APP_CRASH] }
        ],
        onReceive: (domain: string, appEventGroups: Array<hiAppEvent.AppEventGroup>) => {
          let total = 0;
          for (let g = 0; g < appEventGroups.length; g++) {
            const group = appEventGroups[g];
            total += group.appEventInfos.length;
            for (let i = 0; i < group.appEventInfos.length; i++) {
              reportCrash(group.appEventInfos[i]);
            }
          }
          hilog.info(DOMAIN, TAG, 'onReceive fired: %{public}d events', total);
          setStatus(`æ”¶åˆ° ${total} æ¡å´©æºƒäº‹ä»¶ï¼Œä¸ŠæŠ¥ä¸­`);
        }
      });
      hilog.info(DOMAIN, TAG, '%{public}s', 'Crash watcher registered');
      setStatus('watcher å·²æ³¨å†Œï¼Œç­‰å¾…å´©æºƒäº‹ä»¶');
    } catch (error) {
      hilog.error(DOMAIN, TAG, 'addWatcher failed: %{public}s', (error as Error).message);
      setStatus(`watcher æ³¨å†Œå¤±è´¥: ${(error as Error).message}`);
    }
  }
}
