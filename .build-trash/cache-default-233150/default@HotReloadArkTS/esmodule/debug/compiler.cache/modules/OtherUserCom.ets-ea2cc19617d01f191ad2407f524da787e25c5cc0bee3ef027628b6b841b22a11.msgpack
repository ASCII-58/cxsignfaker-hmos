    AlertDialog.show({
      title: 'å…‹éš†ç™»å½•',
      message: `å°†ä»¥ã€Œ${this.userName || this.userData.phone}ã€çš„èº«ä»½å…‹éš†ç™»å½•ï¼Œæµè§ˆå…¶è¯¾ç¨‹å¹¶ä»£ç­¾ã€‚\nå…‹éš†ä¼šè¯ä»…æœ¬æ¬¡è¿è¡Œæœ‰æ•ˆï¼Œå¯éšæ—¶é€€å‡ºã€‚`,
      primaryButton: {
        value: 'å–æ¶ˆ',
        action: () => {}
      },
      secondaryButton: {
        value: 'å…‹éš†ç™»å½•',
        action: () => {
          AppStorage.setOrCreate('cloneSessionCookies', this.userData.cookies)
          AppStorage.setOrCreate('cloneSessionName', this.userName || this.userData.phone)
          AppStorage.setOrCreate('cloneSessionPhone', this.userData.phone)
          if (this.onCloneLogin) {
            this.onCloneLogin()
          }
        }
      }
    })
  }

  private showDeleteDialog() {
    AlertDialog.show({
      title: 'ç¡®è®¤åˆ é™¤',
      message: `ç¡®è®¤åˆ é™¤ç”¨æˆ·${this.userName}å—ï¼Ÿ\n`,
      primaryButton: {
        value: 'å–æ¶ˆ',
        action: () => {}
      },
      secondaryButton: {
        value: 'åˆ é™¤',
        action: () => {
          this.dbManger.deleteUser(this.userData.id).then(result => {
            if (result === 1) {
              this.otherUserList.splice(this.index, 1)
            }
          })
        }
      }
    })
  }

  build() {
    Row() {
      Image(this.userImage) .draggable(false)
        .width(44).height(44)
        .borderRadius(10)
        .alt($r('app.media.foreground'))
      Column() {
        Text(this.userName)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.primary_text'))
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
        Text(this.userData.phone)
          .fontSize(13)
          .fontColor($r('app.color.secondary_text'))
      }
      .layoutWeight(1)
      .alignItems(HorizontalAlign.Start)
      .margin({ left: 12 })

      Column() {
        Image($r('app.media.person_2')) .draggable(false)
          .width(18).height(18)
          .fillColor($r('app.color.selected'))
      }
      .width(32).height(32).borderRadius(16)
      .justifyContent(FlexAlign.Center)
      .scale({ x: this.iconPressed === 'clone' ? 0.85 : 1, y: this.iconPressed === 'clone' ? 0.85 : 1 })
      .animation({ duration: 150, curve: Curve.EaseInOut })
      .onTouch((event: TouchEvent) => {
        this.iconPressed = event.type === TouchType.Down ? 'clone' : ''
      })
      .onClick(() => { this.showCloneDialog() })

      Column() {
        Image($r('app.media.share')) .draggable(false)
          .width(18).height(18)
          .fillColor($r('app.color.icon'))
      }
      .width(32).height(32).borderRadius(16)
      .justifyContent(FlexAlign.Center)
      .scale({ x: this.iconPressed === 'share' ? 0.85 : 1, y: this.iconPressed === 'share' ? 0.85 : 1 })
      .animation({ duration: 150, curve: Curve.EaseInOut })
      .onTouch((event: TouchEvent) => {
        this.iconPressed = event.type === TouchType.Down ? 'share' : ''
      })
      .onClick(() => { this.shareDialogVisible = true })

      Column() {
        Image($r('app.media.ic_public_delete')) .draggable(false)
          .width(18).height(18)
          .fillColor($r('app.color.unsignable'))
      }
      .width(32).height(32).borderRadius(16)
      .justifyContent(FlexAlign.Center)
      .scale({ x: this.iconPressed === 'delete' ? 0.85 : 1, y: this.iconPressed === 'delete' ? 0.85 : 1 })
      .animation({ duration: 150, curve: Curve.EaseInOut })
      .onTouch((event: TouchEvent) => {
        this.iconPressed = event.type === TouchType.Down ? 'delete' : ''
      })
      .onClick(() => { this.showDeleteDialog() })
    }
    .width('100%').height(68)
    .backgroundColor($r('app.color.card_background'))
    .padding({ left: 16, right: 16 })
    .onAppear(async () => {
      if (!this.isLoaded) {
        let userInfo = await loginFunction.getUserInfo(this.userData.cookies)
        this.userName = userInfo.uname
        this.userImage = await loginFunction.GetPic(userInfo.pic)
        this.isLoaded = true
      }
    })
    .bindSheet($$this.shareDialogVisible, this.QRShareSheetContent, {
      height: 'auto', detents: [SheetSize.MEDIUM, SheetSize.LARGE],
      backgroundColor: $r('sys.color.ohos_id_color_sub_background')
    })
  }
}
