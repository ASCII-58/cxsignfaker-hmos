  }

  /**
   * å°† Set-Cookie å“åº”å¤´åˆ—è¡¨å¤„ç†æˆå¯ç”¨äºè¯·æ±‚çš„ Cookie å­—ç¬¦ä¸²
   * 
   * ä»æœåŠ¡å™¨è¿”å›çš„ Set-Cookie å¤´éƒ¨æå– name=value å¯¹ï¼Œ
   * å¹¶æ ¼å¼åŒ–ä¸ºæ ‡å‡†çš„ Cookie è¯·æ±‚å¤´æ ¼å¼
   * 
   * @param {string[]} setCookieHeaders æœåŠ¡å™¨è¿”å›çš„ Set-Cookie å¤´éƒ¨å­—ç¬¦ä¸²æ•°ç»„
   * @returns {string} å¤„ç†åçš„ Cookie å­—ç¬¦ä¸²ï¼Œæ ¼å¼ä¸º "name1=value1; name2=value2"
   * @example
   * const setCookies = ["session=abc123; Path=/", "token=xyz789; HttpOnly"];
   * const cookie = ChaoxingUtils.processSetCookieHeaders(setCookies);
   * // è¿”å›: "session=abc123; token=xyz789"
   */
  static processSetCookieHeaders(setCookieHeaders: string[]): string {
    if (!Array.isArray(setCookieHeaders) || setCookieHeaders.length === 0) {
      return '';
    }

    return setCookieHeaders
      .map(cookie => cookie.split(';')[0].trim()) // æå–æ¯ä¸ª Set-Cookie çš„ name=value
      .join('; ');
  }
  /**
   * è·å–ç­¾åˆ°æ´»åŠ¨å‰©ä½™æ—¶é—´ï¼ˆæ¯«ç§’ï¼‰
   * 
   * @param {number} endTime æ´»åŠ¨ç»“æŸæ—¶é—´æˆ³ï¼ˆæ¯«ç§’ï¼‰
   * @returns {number} å‰©ä½™æ—¶é—´ï¼ˆæ¯«ç§’ï¼‰ï¼Œæœ€å°ä¸º0
   * @example
   * const remaining = ChaoxingUtils.getRemainingTime(Date.now() + 3600000);
   * // è¿”å›: 3600000 (1å°æ—¶)
   */
  static getRemainingTime(endTime: number): number {
    const currentTime = Date.now();
    return Math.max(0, endTime - currentTime);
  }

  /**
   * æ£€æŸ¥ç­¾åˆ°æ´»åŠ¨æ˜¯å¦æ­£åœ¨è¿›è¡Œä¸­
   * 
   * @param {number} startTime æ´»åŠ¨å¼€å§‹æ—¶é—´æˆ³ï¼ˆæ¯«ç§’ï¼‰
   * @param {number} endTime æ´»åŠ¨ç»“æŸæ—¶é—´æˆ³ï¼ˆæ¯«ç§’ï¼‰
   * @returns {boolean} æ´»åŠ¨æ˜¯å¦åœ¨è¿›è¡Œä¸­
   */
  static isSignActivityActive(startTime: number, endTime: number): boolean {
    const currentTime = Date.now();
    return currentTime >= startTime && currentTime <= endTime;
  }

  /**
   * æ£€æŸ¥ç­¾åˆ°æ´»åŠ¨æ˜¯å¦å·²å¼€å§‹
   * 
   * @param {number} startTime æ´»åŠ¨å¼€å§‹æ—¶é—´æˆ³ï¼ˆæ¯«ç§’ï¼‰
   * @returns {boolean} æ´»åŠ¨æ˜¯å¦å·²å¼€å§‹
   */
  static isSignActivityStarted(startTime: number): boolean {
    const currentTime = Date.now();
    return currentTime >= startTime;
  }

  /**
   * æ£€æŸ¥ç­¾åˆ°æ´»åŠ¨æ˜¯å¦å·²ç»“æŸ
   * 
   * @param {number} endTime æ´»åŠ¨ç»“æŸæ—¶é—´æˆ³ï¼ˆæ¯«ç§’ï¼‰
   * @returns {boolean} æ´»åŠ¨æ˜¯å¦å·²ç»“æŸ
   */
  static isSignActivityEnded(endTime: number): boolean {
    const currentTime = Date.now();
    return currentTime > endTime;
  }

  static copyText(text: string) {
    const pasteboardData = pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, text)
    const systemPasteboard = pasteboard.getSystemPasteboard()
    systemPasteboard.setData(pasteboardData)
    promptAction.showToast({ message: 'å·²å¤åˆ¶åˆ°å‰ªè´´æ¿', duration: 1500 })
  }
}
