        const parts = Object.entries(params).map(([key, value]) => {
            return `${encodeURIComponent(key)}=${encodeURIComponent(value)}`;
        });
        const queryString = parts.join('&');
        // åˆ¤æ–­æ˜¯å¦å·²æœ‰å‚æ•°
        const separator = url.includes('?') ? '&' : '?';
        return `${url}${separator}${queryString}`;
    }
    /**
     * ç”ŸæˆUUIDv4
     * æŒ‰ç…§ RFC 4122 è§„èŒƒç”Ÿæˆç‰ˆæœ¬4çš„UUID
     * @returns {string} UUIDå­—ç¬¦ä¸²ï¼Œæ ¼å¼ä¸º xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
     * @example
     * const uuid = ChaoxingUtils.generateUUIDv4();
     * // è¿”å›ç±»ä¼¼: "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d"
