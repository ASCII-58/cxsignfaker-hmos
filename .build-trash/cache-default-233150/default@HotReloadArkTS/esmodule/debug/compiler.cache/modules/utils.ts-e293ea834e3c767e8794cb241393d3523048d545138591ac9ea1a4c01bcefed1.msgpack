    /**
     * å°†BD-09åæ ‡ç³»ï¼ˆç™¾åº¦åæ ‡ç³»ï¼‰è½¬æ¢ä¸ºGCJ-02åæ ‡ç³»ï¼ˆç«æ˜Ÿåæ ‡ç³»ï¼‰
     *
     * æ”¶è—ä½ç½®åœ¨æ•°æ®åº“ä¸­å­˜çš„æ˜¯ç­¾åˆ°ç”¨çš„ BD-09 åæ ‡ï¼Œ
     * è€Œå†…ç½®åœ°å›¾ï¼ˆé«˜å¾·ç“¦ç‰‡ï¼‰æŒ‰ GCJ-02 å®šä½ï¼Œå±•ç¤ºå‰éœ€è½¬å› GCJ-02
     *
     * @param bd_lat BD-09åæ ‡ç³»çš„çº¬åº¦å€¼ï¼Œå•ä½ä¸ºåº¦
     * @param bd_lon BD-09åæ ‡ç³»çš„ç»åº¦å€¼ï¼Œå•ä½ä¸ºåº¦
     * @returns è½¬æ¢åçš„GCJ-02åæ ‡ { lat, lon }
     */
    static bd09_to_gcj02(bd_lat, bd_lon) {
        const x = bd_lon - 0.0065;
        const y = bd_lat - 0.006;
        const z = Math.sqrt(x * x + y * y) - 0.00002 * Math.sin(y * ChaoxingUtils.x_pi);
        const theta = Math.atan2(y, x) - 0.000003 * Math.cos(x * ChaoxingUtils.x_pi);
        return { lat: z * Math.sin(theta), lon: z * Math.cos(theta) };
    }
    /**
     * å°†WGS-84åæ ‡ç³»ï¼ˆGPSè®¾å¤‡åŸå§‹åæ ‡ï¼‰è½¬æ¢ä¸ºGCJ-02åæ ‡ç³»ï¼ˆç«æ˜Ÿåæ ‡ï¼‰
     *
     * geoLocationManager å®šä½è¿”å› WGS-84ï¼Œè€Œåœ°å›¾é€‰ç‚¹è¿”å› GCJ-02ï¼›
     * æäº¤ç­¾åˆ°å‰ç»Ÿä¸€èµ° WGS-84 â†’ GCJ-02 â†’ BD-09 çš„é“¾è·¯
     *
     * @param wg_lat WGS-84çº¬åº¦å€¼ï¼Œå•ä½ä¸ºåº¦
     * @param wg_lon WGS-84ç»åº¦å€¼ï¼Œå•ä½ä¸ºåº¦
     * @returns è½¬æ¢åçš„GCJ-02åæ ‡ { lat, lon }ï¼ˆå¢ƒå¤–åæ ‡ä¸åšåç§»ï¼ŒåŸæ ·è¿”å›ï¼‰
     */
    static wgs84_to_gcj02(wg_lat, wg_lon) {
        // ç²—ç•¥åˆ¤æ–­æ˜¯å¦åœ¨ä¸­å›½åæ ‡èŒƒå›´å¤–ï¼Œå¢ƒå¤–æ— åç§»å‚æ•°ï¼Œç›´æ¥è¿”å›
        if (wg_lon < 72.004 || wg_lon > 137.8347 || wg_lat < 0.8293 || wg_lat > 55.8271) {
            return { lat: wg_lat, lon: wg_lon };
        }
        let dLat = ChaoxingUtils.transformLat(wg_lon - 105.0, wg_lat - 35.0);
        let dLon = ChaoxingUtils.transformLon(wg_lon - 105.0, wg_lat - 35.0);
        const radLat = wg_lat / 180.0 * Math.PI;
        let magic = Math.sin(radLat);
