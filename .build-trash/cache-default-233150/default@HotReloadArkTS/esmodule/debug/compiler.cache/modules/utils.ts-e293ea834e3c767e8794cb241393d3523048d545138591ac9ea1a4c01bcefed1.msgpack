    /**
     * å°†GCJ-02åæ ‡ç³»ï¼ˆç«æ˜Ÿåæ ‡ç³»ï¼‰è½¬æ¢ä¸ºBD-09åæ ‡ç³»ï¼ˆç™¾åº¦åæ ‡ç³»ï¼‰
     *
     * ç®—æ³•åŸç†ï¼š
     * è¯¥ç®—æ³•é€šè¿‡æåæ ‡å˜æ¢çš„æ–¹å¼ï¼Œåœ¨GCJ-02åæ ‡çš„åŸºç¡€ä¸Šæ·»åŠ ç‰¹å®šçš„åç§»é‡ï¼Œ
     * å°†åæ ‡è½¬æ¢ä¸ºç™¾åº¦åœ°å›¾ä½¿ç”¨çš„BD-09åæ ‡ç³»ã€‚
     *
     * @param gg_lat GCJ-02åæ ‡ç³»çš„çº¬åº¦å€¼ï¼Œå•ä½ä¸ºåº¦
     * @param gg_lon GCJ-02åæ ‡ç³»çš„ç»åº¦å€¼ï¼Œå•ä½ä¸ºåº¦
     * @returns è½¬æ¢åçš„BD-09åæ ‡ç³»åæ ‡ï¼ŒåŒ…å«çº¬åº¦(lat)å’Œç»åº¦(lon)çš„å¯¹è±¡
     *
     * @example
    * // è½¬æ¢åŒ—äº¬å¤©å®‰é—¨é™„è¿‘çš„åæ ‡ç¤ºä¾‹
     * const result = gcj02_to_bd09(39.9042, 116.4074);
     * console.log(result); // è¾“å‡ºç±»ä¼¼: { lat: 39.9107, lon: 116.4155 }
     */
    static gcj02_to_bd09(gg_lat, gg_lon) {
        // å°†ç»åº¦å’Œçº¬åº¦åˆ†åˆ«èµ‹å€¼ç»™ä¸´æ—¶å˜é‡xå’Œy
        // æ³¨æ„è¿™é‡Œä½¿ç”¨çš„æ˜¯ä¼ ç»Ÿçš„æ•°å­¦åæ ‡è¡¨ç¤ºæ³•ï¼Œxè¡¨ç¤ºç»åº¦ï¼Œyè¡¨ç¤ºçº¬åº¦
        const x = gg_lon;
        const y = gg_lat;
        // è®¡ç®—zå€¼ï¼šåœ¨åŸæœ‰è·ç¦»åŸºç¡€ä¸ŠåŠ ä¸Šä¸€ä¸ªå¾®å°çš„ä¿®æ­£é‡
        // è¿™ä¸ªä¿®æ­£å¼ä½¿ç”¨æ­£å¼¦å‡½æ•°ï¼Œæ ¹æ®çº¬åº¦äº§ç”Ÿä¸åŒçš„åç§»é‡
        const z = Math.sqrt(x * x + y * y) + 0.00002 * Math.sin(y * ChaoxingUtils.x_pi);
        // è®¡ç®—thetaå€¼ï¼šåœ¨åŸæœ‰è§’åº¦åŸºç¡€ä¸ŠåŠ ä¸Šä¸€ä¸ªå¾®å°çš„ä¿®æ­£é‡
        // è¿™ä¸ªä¿®æ­£å¼ä½¿ç”¨ä½™å¼¦å‡½æ•°ï¼Œæ ¹æ®ç»åº¦äº§ç”Ÿä¸åŒçš„åç§»é‡
        // atan2(y, x)è®¡ç®—çš„æ˜¯ç‚¹(x,y)ä¸åŸç‚¹è¿çº¿ä¸xè½´æ­£æ–¹å‘çš„å¤¹è§’
        const theta = Math.atan2(y, x) + 0.000003 * Math.cos(x * ChaoxingUtils.x_pi);
        // è®¡ç®—è½¬æ¢åçš„BD-09åæ ‡ç³»ç»åº¦
        // ä½¿ç”¨æåæ ‡è½¬ç›´è§’åæ ‡çš„å…¬å¼ï¼Œæœ€ååŠ ä¸Šå›ºå®šåç§»é‡0.0065
        const bd_lon = z * Math.cos(theta) + 0.0065;
        // è®¡ç®—è½¬æ¢åçš„BD-09åæ ‡ç³»çº¬åº¦
        // ä½¿ç”¨æåæ ‡è½¬ç›´è§’åæ ‡çš„å…¬å¼ï¼Œæœ€ååŠ ä¸Šå›ºå®šåç§»é‡0.006
        const bd_lat = z * Math.sin(theta) + 0.006;
        // è¿”å›åŒ…å«è½¬æ¢åç»çº¬åº¦çš„å¯¹è±¡
        // æŒ‰ç…§åœ°å›¾åæ ‡çš„ä¹ æƒ¯ï¼Œå…ˆè¿”å›çº¬åº¦ï¼Œå†è¿”å›ç»åº¦
        return { lat: bd_lat, lon: bd_lon };
