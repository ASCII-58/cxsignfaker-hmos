        hilog.info(DOMAIN, TAG, '%{public}s', 'Database connection closed');
      }
    } catch (error) {
      const err = error as BusinessError;
      hilog.error(DOMAIN, TAG, 'Failed to close database: Code=%{public}d, Message=%{public}s',
        err.code, err.message);
