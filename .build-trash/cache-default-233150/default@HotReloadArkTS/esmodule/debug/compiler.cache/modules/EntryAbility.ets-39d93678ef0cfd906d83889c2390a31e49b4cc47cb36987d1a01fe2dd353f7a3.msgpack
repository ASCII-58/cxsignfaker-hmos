import { LeaderboardReporter } from '../utils/LeaderboardReporter';
import { BusinessError } from '@kit.BasicServicesKit';

const DOMAIN = 0x0000;
const TAG = 'DB_INIT';

export default class EntryAbility extends UIAbility {
  // æ•°æ®åº“åˆå§‹åŒ–çŠ¶æ€
